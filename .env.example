# Puerto del microservicio de Usuarios
PORT=3001
# mysql (normal) | memory (sin base de datos, para pruebas/demostración)
DATA_STORE=mysql
DB_HOST=localhost
DB_PORT=3306
# Con XAMPP normalmente: DB_USER=root y DB_PASSWORD vacío
DB_USER=root
DB_PASSWORD=
DB_NAME=bookshare_usuarios
DB_CONNECT_TIMEOUT_MS=5000
# Secreto para firmar los JWT (cámbielo y no lo suba al repositorio)
JWT_SECRET=cambiar-este-secreto-en-produccion
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=10
DOMINIO_INSTITUCIONAL=uniminuto.edu.co
