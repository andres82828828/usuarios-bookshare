{
  "name": "bookshare-usuarios-service",
  "version": "1.0.0",
  "description": "Microservicio de Usuarios (registro, autenticación y perfiles) de BookShare",
  "main": "src/server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:memoria": "node src/server.js --memoria",
    "db:init": "node scripts/init-db.js",
    "db:generar": "node scripts/generar-semilla.js",
    "test": "jest --verbose --runInBand"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ],
    "verbose": true
  }
}
